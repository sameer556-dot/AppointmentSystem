# ==============================================================================
# Root .gitignore — Digital Appointment Web Application (AppointEase)
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/

# Python Bytecode & Cache
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Local SQLite Database Files (prevents leaking personal appointment records)
database/*.db
*.sqlite
*.sqlite3
*.db

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!*.env.example

# Node Dependencies & Frontend Build Output
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & Editor Metadata
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
