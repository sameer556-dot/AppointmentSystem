# Backend Environment Configuration
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=generate-a-strong-random-32-byte-hex-string-for-production

# Database Configuration
# Local SQLite default: sqlite:///database/appointments.db
# Neon PostgreSQL for Production:
DATABASE_URL=postgresql://username:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# CORS: Set to your live Vercel frontend URL(s) (comma-separated for multiple)
CORS_ORIGINS=https://your-frontend-app.vercel.app

# Server Port (optional; used when running python app.py locally)
PORT=5000

# Server Timezone
TZ=Asia/Kolkata
